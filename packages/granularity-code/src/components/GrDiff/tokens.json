{
  "tokens": [
    {
      "name": "--gr-diff-added",
      "kind": "hook",
      "default": "var(--gr-success-light)",
      "description": "Подложка добавленной строки."
    },
    {
      "name": "--gr-diff-removed",
      "kind": "hook",
      "default": "var(--gr-danger-light)",
      "description": "Подложка удалённой строки."
    },
    {
      "name": "--gr-diff-word-added",
      "kind": "hook",
      "default": "var(--gr-success)",
      "description": "Подсветка добавленного слова внутри строки."
    },
    {
      "name": "--gr-diff-word-removed",
      "kind": "hook",
      "default": "var(--gr-danger)",
      "description": "Подсветка удалённого слова внутри строки."
    },
    {
      "name": "--gr-diff-gutter",
      "kind": "hook",
      "default": "var(--gr-muted-fg)",
      "description": "Цвет номеров строк и знака правки в жёлобе."
    },
    {
      "name": "--gr-diff-word-added-fg",
      "kind": "hook",
      "default": "var(--gr-success-fg)",
      "description": "Цвет текста на подсветке добавленного слова."
    },
    {
      "name": "--gr-diff-word-removed-fg",
      "kind": "hook",
      "default": "var(--gr-danger-fg)",
      "description": "Цвет текста на подсветке удалённого слова."
    },
    {
      "name": "--gr-diff-gap-bg",
      "kind": "hook",
      "default": "var(--gr-bg)",
      "description": "Подложка полосы пропуска."
    }
  ]
}
