{
  "tokens": [
    {
      "name": "--gr-code-block-bg",
      "kind": "hook",
      "default": "var(--gr-muted)",
      "description": "Фон поверхности кода — блока, диффа и редактора."
    },
    {
      "name": "--gr-code-block-fg",
      "kind": "hook",
      "default": "var(--gr-fg)",
      "description": "Цвет текста по умолчанию."
    },
    {
      "name": "--gr-code-block-key",
      "kind": "hook",
      "default": "var(--gr-primary-text)",
      "description": "Имя поля объекта."
    },
    {
      "name": "--gr-code-block-string",
      "kind": "hook",
      "default": "var(--gr-success-text)",
      "description": "Строковый литерал."
    },
    {
      "name": "--gr-code-block-number",
      "kind": "hook",
      "default": "var(--gr-azure-text)",
      "description": "Число."
    },
    {
      "name": "--gr-code-block-literal",
      "kind": "hook",
      "default": "var(--gr-warning-text)",
      "description": "`true`, `false`, `null` и их аналоги."
    },
    {
      "name": "--gr-code-block-punctuation",
      "kind": "hook",
      "default": "var(--gr-fg)",
      "description": "Скобки, запятые, двоеточия, операторы."
    },
    {
      "name": "--gr-code-block-keyword",
      "kind": "hook",
      "default": "var(--gr-danger-text)",
      "description": "Ключевое слово языка."
    },
    {
      "name": "--gr-code-block-comment",
      "kind": "hook",
      "default": "var(--gr-muted-fg)",
      "description": "Комментарий."
    },
    {
      "name": "--gr-code-block-type",
      "kind": "hook",
      "default": "var(--gr-info-text)",
      "description": "Имя типа, класса, интерфейса."
    },
    {
      "name": "--gr-code-block-function",
      "kind": "hook",
      "default": "var(--gr-slate-text)",
      "description": "Имя функции."
    },
    {
      "name": "--gr-code-block-variable",
      "kind": "hook",
      "default": "var(--gr-fg)",
      "description": "Имя переменной или параметра."
    },
    {
      "name": "--gr-code-block-line-number",
      "kind": "hook",
      "default": "var(--gr-muted-fg)",
      "description": "Цвет номера строки в жёлобе."
    },
    {
      "name": "--gr-code-block-line-number-width",
      "kind": "hook",
      "default": "2.5em",
      "description": "Ширина жёлоба с номерами строк."
    }
  ]
}
