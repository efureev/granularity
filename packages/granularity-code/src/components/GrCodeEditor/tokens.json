{
  "tokens": [
    {
      "name": "--gr-code-editor-selection",
      "kind": "hook",
      "default": "var(--gr-info-light)",
      "description": "Подложка выделенного текста в редакторе."
    },
    {
      "name": "--gr-code-editor-cursor",
      "kind": "hook",
      "default": "var(--gr-fg)",
      "description": "Цвет каретки."
    },
    {
      "name": "--gr-code-editor-placeholder",
      "kind": "hook",
      "default": "var(--gr-muted-fg)",
      "description": "Цвет текста-подсказки в пустом редакторе."
    },
    {
      "name": "--gr-code-editor-active-line",
      "kind": "hook",
      "default": "transparent",
      "description": "Подложка строки под кареткой."
    },
    {
      "name": "--gr-code-editor-issue-error",
      "kind": "hook",
      "default": "var(--gr-invalid-text)",
      "description": "Цвет волнистого подчёркивания и метки в жёлобе у замечания важности `error`."
    },
    {
      "name": "--gr-code-editor-issue-warning",
      "kind": "hook",
      "default": "var(--gr-warning-text)",
      "description": "Цвет подчёркивания и метки у замечания важности `warning`."
    },
    {
      "name": "--gr-code-editor-issue-info",
      "kind": "hook",
      "default": "var(--gr-info-text)",
      "description": "Цвет подчёркивания и метки у замечания важности `info`."
    }
  ]
}
