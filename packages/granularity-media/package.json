{
  "name": "@feugene/granularity-media",
  "description": "Media components for @feugene/granularity: image cropping, camera capture, code scanning and video playback.",
  "version": "0.7.1",
  "license": "LicenseRef-Granularity-EUC-1.1",
  "author": {
    "name": "Evgeniy Fureev",
    "url": "https://github.com/efureev"
  },
  "homepage": "https://efureev.github.io/granularity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efureev/granularity.git",
    "directory": "packages/granularity-media"
  },
  "bugs": {
    "url": "https://github.com/efureev/granularity/issues"
  },
  "keywords": [
    "granularity",
    "design-system",
    "vue",
    "image-crop",
    "avatar",
    "camera",
    "barcode",
    "video"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/GrCameraCapture": {
      "types": "./dist/types/components/GrCameraCapture/index.d.ts",
      "import": "./dist/components/GrCameraCapture/index.js"
    },
    "./components/GrCodeScanner": {
      "types": "./dist/types/components/GrCodeScanner/index.d.ts",
      "import": "./dist/components/GrCodeScanner/index.js"
    },
    "./components/GrImageCrop": {
      "types": "./dist/types/components/GrImageCrop/index.d.ts",
      "import": "./dist/components/GrImageCrop/index.js"
    },
    "./components/GrVideoPlayer": {
      "types": "./dist/types/components/GrVideoPlayer/index.d.ts",
      "import": "./dist/components/GrVideoPlayer/index.js"
    },
    "./i18n": {
      "types": "./dist/types/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./i18n/all": {
      "types": "./dist/types/i18n/all.d.ts",
      "import": "./dist/i18n/all.js"
    },
    "./granular-provider": {
      "types": "./dist/types/granular-provider/index.d.ts",
      "import": "./dist/granular-provider.js"
    },
    "./granular-provider/node": {
      "types": "./dist/types/granular-provider/node.d.ts",
      "import": "./dist/granular-provider-node.js"
    },
    "./resolver": {
      "types": "./dist/types/resolver.d.ts",
      "import": "./dist/resolver.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@feugene/fint-i18n": ">=0.7.0 <1.0.0",
    "@feugene/granularity": ">=0.38.0 <1.0.0",
    "@feugene/unocss-preset-granular": ">=0.13.0 <1.0.0",
    "@feugene/unplugin-granularity": ">=0.7.0 <1.0.0",
    "unplugin-vue-components": ">=0.26.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@feugene/fint-i18n": {
      "optional": true
    },
    "@feugene/unplugin-granularity": {
      "optional": true
    },
    "unplugin-vue-components": {
      "optional": true
    }
  },
  "scripts": {
    "build": "vite build && gr-check-dist-dev-guard && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "doctor": "node ../../scripts/granular-doctor.mjs ./granular.options.mjs",
    "sizes": "node ../../scripts/report-entry-sizes.mjs .",
    "sizes:docs": "node ../../scripts/generate-entry-sizes.mjs .",
    "generate:registry": "node scripts/generate-registry.mjs",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check:messages": "fint-i18n-check-messages src/i18n/locales"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@feugene/fint-i18n": "^0.7.0",
    "@feugene/granularity": "^0.41.0",
    "@feugene/granularity-test-kit": "^0.10.0",
    "@feugene/unocss-preset-granular": "^0.16.0",
    "@feugene/unplugin-granularity": "^0.7.0",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "~4.13.0",
    "eslint": "^10.9.1",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
