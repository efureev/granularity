{
  "name": "@feugene/granularity-charts",
  "description": "Charts for the @feugene/granularity design system — own SVG, zero dependencies, drawn with theme tokens.",
  "version": "0.9.0",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Evgeniy Fureev",
    "url": "https://github.com/efureev"
  },
  "homepage": "https://efureev.github.io/granularity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efureev/granularity.git",
    "directory": "packages/granularity-charts"
  },
  "bugs": {
    "url": "https://github.com/efureev/granularity/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "charts",
    "chart",
    "sparkline",
    "dataviz",
    "svg",
    "granularity",
    "design-system",
    "tree-shakeable",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/GrChartArea": {
      "types": "./dist/types/components/GrChartArea/index.d.ts",
      "import": "./dist/components/GrChartArea/index.js"
    },
    "./components/GrChartBar": {
      "types": "./dist/types/components/GrChartBar/index.d.ts",
      "import": "./dist/components/GrChartBar/index.js"
    },
    "./components/GrChartBullet": {
      "types": "./dist/types/components/GrChartBullet/index.d.ts",
      "import": "./dist/components/GrChartBullet/index.js"
    },
    "./components/GrChartFunnel": {
      "types": "./dist/types/components/GrChartFunnel/index.d.ts",
      "import": "./dist/components/GrChartFunnel/index.js"
    },
    "./components/GrChartHeatmap": {
      "types": "./dist/types/components/GrChartHeatmap/index.d.ts",
      "import": "./dist/components/GrChartHeatmap/index.js"
    },
    "./components/GrChartLine": {
      "types": "./dist/types/components/GrChartLine/index.d.ts",
      "import": "./dist/components/GrChartLine/index.js"
    },
    "./components/GrChartPie": {
      "types": "./dist/types/components/GrChartPie/index.d.ts",
      "import": "./dist/components/GrChartPie/index.js"
    },
    "./components/GrChartRadar": {
      "types": "./dist/types/components/GrChartRadar/index.d.ts",
      "import": "./dist/components/GrChartRadar/index.js"
    },
    "./components/GrChartWaterfall": {
      "types": "./dist/types/components/GrChartWaterfall/index.d.ts",
      "import": "./dist/components/GrChartWaterfall/index.js"
    },
    "./components/GrSparkline": {
      "types": "./dist/types/components/GrSparkline/index.d.ts",
      "import": "./dist/components/GrSparkline/index.js"
    },
    "./chart": {
      "types": "./dist/types/chart/index.d.ts",
      "import": "./dist/chart/index.js"
    },
    "./composables/useChartScale": {
      "types": "./dist/types/composables/useChartScale.d.ts",
      "import": "./dist/composables/useChartScale.js"
    },
    "./composables/useChartTicks": {
      "types": "./dist/types/composables/useChartTicks.d.ts",
      "import": "./dist/composables/useChartTicks.js"
    },
    "./composables/useChartTooltip": {
      "types": "./dist/types/composables/useChartTooltip.d.ts",
      "import": "./dist/composables/useChartTooltip.js"
    },
    "./i18n": {
      "types": "./dist/types/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./i18n/all": {
      "types": "./dist/types/i18n/all.d.ts",
      "import": "./dist/i18n/all.js"
    },
    "./granular-provider": {
      "types": "./dist/types/granular-provider/index.d.ts",
      "import": "./dist/granular-provider.js",
      "default": "./dist/granular-provider.js"
    },
    "./granular-provider/node": {
      "types": "./dist/types/granular-provider/node.d.ts",
      "import": "./dist/granular-provider-node.js",
      "default": "./dist/granular-provider-node.js"
    },
    "./resolver": {
      "types": "./dist/types/resolver.d.ts",
      "import": "./dist/resolver.js",
      "default": "./dist/resolver.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@feugene/granularity": ">=0.21.0 <1.0.0",
    "@feugene/unocss-preset-granular": "^0.10.1",
    "vue": "^3.5.0",
    "@feugene/unplugin-granularity": ">=0.4.0 <1.0.0",
    "unplugin-vue-components": ">=0.26.0",
    "@feugene/fint-i18n": "^0.6.0"
  },
  "peerDependenciesMeta": {
    "@feugene/unplugin-granularity": {
      "optional": true
    },
    "unplugin-vue-components": {
      "optional": true
    },
    "@feugene/fint-i18n": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@feugene/fint-i18n": "^0.6.0",
    "@feugene/granularity": "^0.30.0",
    "@feugene/granularity-test-kit": "^0.7.0",
    "@feugene/unocss-preset-granular": "^0.10.1",
    "@feugene/unplugin-granularity": "^0.6.0",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "~4.12.1",
    "eslint": "^10.7.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.2",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.1.5",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  },
  "scripts": {
    "build": "vite build && gr-check-dist-dev-guard && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "doctor": "granular doctor ./granular.options.mjs --strict",
    "generate:registry": "node scripts/generate-registry.mjs",
    "check:messages": "fint-i18n-check-messages src/i18n/locales",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  }
}
