{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "declarationDir": "./dist/types",
    "outDir": "./dist",
    // Перечислено заново, а не унаследовано: `types` из `extends` не мержится.
    // Третий пакет заменяет `vite-env.d.ts`, который под `rootDir: "src"` в
    // компиляцию не входит, — без него не резолвится `~icons/lucide/*`.
    "types": ["vite/client", "node", "unplugin-icons/types/vue"]
  },
  "include": [
    // Объявление `__GR_DEV__`: файл вне `rootDir`, но `.d.ts` вывода не даёт,
    // а без него сборка типов не знает про подставляемую константу.
    "vite-env.d.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}