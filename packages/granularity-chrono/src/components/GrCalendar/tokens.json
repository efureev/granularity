{
  "owner": "GrCalendar",
  "tokens": [
    {
      "name": "--gr-calendar-bg",
      "kind": "hook",
      "default": "var(--gr-card)",
      "description": "Фон панели календаря."
    },
    {
      "name": "--gr-calendar-padding",
      "kind": "hook",
      "default": "0.75rem",
      "description": "Внутренний отступ панели."
    },
    {
      "name": "--gr-calendar-selected-bg",
      "kind": "hook",
      "default": "var(--gr-primary)",
      "description": "Заливка выбранного дня."
    },
    {
      "name": "--gr-calendar-selected-fg",
      "kind": "hook",
      "default": "var(--gr-primary-fg)",
      "description": "Текст выбранного дня. Обязан проходить AA на своей заливке."
    },
    {
      "name": "--gr-calendar-hover-bg",
      "kind": "hook",
      "default": "var(--gr-muted)",
      "description": "Подсветка дня под курсором."
    },
    {
      "name": "--gr-calendar-today-ring",
      "kind": "hook",
      "default": "var(--gr-primary)",
      "description": "Обводка сегодняшнего дня. Состояние несёт не только цвет — форму тоже."
    },
    {
      "name": "--gr-calendar-outside-fg",
      "kind": "hook",
      "default": "var(--gr-muted-fg)",
      "description": "Текст дней добора соседних месяцев."
    },
    {
      "name": "--gr-calendar-range-bg",
      "kind": "hook",
      "default": "var(--gr-muted)",
      "description": "Полоса выбранного диапазона. Рисуется на ячейке, чтобы полоса была сплошной."
    }
  ]
}
