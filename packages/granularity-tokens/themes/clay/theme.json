{
  "id": "clay",
  "title": "Глина",
  "description": "Тёплая бумага, графитовые чернила и одна глиняная точка на экран.",
  "docs": "https://granularity.tech/themes/clay",
  "version": "2.0.1",
  "targets": {
    "@feugene/granularity": "^3.1.0",
    "@feugene/granularity-charts": "^3.0.0",
    "@feugene/granularity-media": "^3.0.0"
  },
  "defaultMode": "light",
  "modes": {
    "light": {
      "title": "Светлый",
      "colorScheme": "light"
    },
    "dark": {
      "title": "Тёмный",
      "colorScheme": "dark"
    }
  },
  "extensions": {
    "granularity": {
      "componentDefaults": {
        "GrAvatar": {
          "autoColor": false
        },
        "GrBadge": {
          "radius": "semi"
        },
        "GrBreadcrumbs": {
          "separator": "/"
        },
        "GrButton": {
          "loadingIndicator": "shimmer",
          "tone": "neutral"
        },
        "GrButtonGroup": {
          "appearance": "tray"
        },
        "GrConfirmDialog": {
          "cancelVariant": "ghost"
        },
        "GrDescriptionList": {
          "labelWidth": "160px"
        },
        "GrFormField": {
          "hintPosition": "bottom"
        },
        "GrPagination": {
          "size": "sm"
        },
        "GrProgressBar": {
          "borderless": true
        },
        "GrPromptDialog": {
          "cancelVariant": "ghost"
        },
        "GrRating": {
          "tone": "neutral"
        },
        "GrSteps": {
          "size": "sm"
        },
        "GrTabs": {
          "variant": "line"
        },
        "GrToaster": {
          "placement": "bottom-right"
        }
      }
    }
  }
}
