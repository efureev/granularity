{
  "name": "@feugene/granularity-test-kit",
  "description": "Test gates for @feugene/granularity design-system packages — token, registry and defaults contracts as reusable factories.",
  "version": "0.7.4",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Evgeniy Fureev",
    "url": "https://github.com/efureev"
  },
  "homepage": "https://efureev.github.io/granularity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efureev/granularity.git",
    "directory": "packages/granularity-test-kit"
  },
  "bugs": {
    "url": "https://github.com/efureev/granularity/issues"
  },
  "keywords": [
    "granularity",
    "design-system",
    "testing",
    "vitest",
    "design-tokens",
    "contract-tests"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "bin",
    "dist"
  ],
  "bin": {
    "gr-check-dist-dev-guard": "./bin/check-dist-dev-guard.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./gates": {
      "types": "./dist/types/gates/index.d.ts",
      "import": "./dist/gates.js",
      "default": "./dist/gates.js"
    },
    "./a11y": {
      "types": "./dist/types/a11y/index.d.ts",
      "import": "./dist/a11y.js",
      "default": "./dist/a11y.js"
    },
    "./vue": {
      "types": "./dist/types/vue/index.d.ts",
      "import": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./e2e": {
      "types": "./dist/types/e2e/index.d.ts",
      "import": "./dist/e2e.js",
      "default": "./dist/e2e.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@axe-core/playwright": ">=4.10",
    "@feugene/unocss-preset-granular": ">=0.11.0 <1.0.0",
    "@playwright/test": ">=1.50",
    "@vue/test-utils": ">=2.4",
    "axe-core": ">=4.10",
    "vitest": ">=3.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@axe-core/playwright": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "@vue/test-utils": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@feugene/unocss-preset-granular": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@axe-core/playwright": "^4.12.1",
    "@feugene/unocss-preset-granular": "^0.11.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "~4.12.1",
    "eslint": "^10.7.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue": "^3.5.40"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
