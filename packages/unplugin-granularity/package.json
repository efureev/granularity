{
  "name": "@feugene/unplugin-granularity",
  "description": "unplugin-vue-components resolver for @feugene/granularity — granular auto-import for components and directives.",
  "version": "0.7.1",
  "license": "LicenseRef-Granularity-EUC-1.1",
  "author": {
    "name": "Evgeniy Fureev",
    "url": "https://github.com/efureev"
  },
  "homepage": "https://efureev.github.io/granularity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efureev/granularity.git",
    "directory": "packages/unplugin-granularity"
  },
  "bugs": {
    "url": "https://github.com/efureev/granularity/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "unplugin",
    "unplugin-vue-components",
    "resolver",
    "auto-import",
    "tree-shaking",
    "granularity",
    "design-system"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@feugene/granularity": ">=0.38.0 <1.0.0",
    "unplugin-vue-components": ">=0.26.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@feugene/granularity": "^0.43.0",
    "@types/node": "^25.9.5",
    "eslint": "^10.9.1",
    "globals": "^16.5.0",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts"
  }
}
