{
  "name": "@feugene/granularity-design",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "@feugene/fint-i18n": "^0.9.0",
    "@feugene/granularity": "^3.0.0",
    "@feugene/granularity-tokens": "^2.0.0",
    "marked": "^18.0.12",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@axe-core/playwright": "^4.13.0",
    "@feugene/granum": "^3.12.0",
    "@feugene/granum-engine-wind": "^3.12.0",
    "@feugene/unplugin-granularity": "^1.1.0",
    "@iconify-json/lucide": "^1.2.126",
    "@playwright/test": "^1.62.1",
    "@unocss/reset": "^66.8.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "scripts": {
    "dev": "yarn prepare:granularity && vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare:granularity": "yarn workspace @feugene/granularity-tokens build && yarn workspace @feugene/granularity build",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  }
}
