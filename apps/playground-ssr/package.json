{
  "name": "@feugene/granularity-playground-ssr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "@feugene/granularity": "^0.35.0",
    "@feugene/granularity-charts": "^0.9.0",
