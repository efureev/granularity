{
  "name": "@feugene/granularity-showcase",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "dependencies": {
    "@feugene/fint-i18n": "^0.7.0",
    "@feugene/granularity": "^0.47.0",
    "@feugene/granularity-charts": "^0.11.0",
    "@feugene/granularity-chrono": "^0.10.0",
    "@feugene/granularity-code": "^0.2.0",
    "@feugene/granularity-dashboard": "^0.6.0",
    "@feugene/granularity-datasource": "^0.1.2",
    "@feugene/granularity-devtools": "^0.3.0",
    "@feugene/granularity-editor": "^0.3.1",
    "@feugene/granularity-forms-schema": "^0.4.0",
    "@feugene/granularity-media": "^0.7.1",
    "@feugene/unocss-preset-granular": "^0.16.0",
    "@floating-ui/dom": "^1.8.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@axe-core/playwright": "^4.13.0",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@feugene/granularity-test-kit": "^0.10.0",
    "@feugene/unplugin-granularity": "^0.7.0",
    "@playwright/test": "^1.62.1",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extensions": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@unocss/reset": "^66.8.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "shiki": "^4.4.3",
    "typescript": "^6.0.3",
    "unocss": "^66.8.1",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-component-meta": "^3.3.11",
    "vue-tsc": "^3.3.11",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "yarn generate:api && yarn generate:search && vite build && yarn verify:locales",
    "verify:locales": "node ./checks/verify-locales.mjs",
    "build:analyze": "yarn generate:api && yarn generate:search && vite build --mode analyze",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "dev": "yarn prepare:granularity && yarn generate:api && yarn generate:search && vite",
    "generate:api": "node ./scripts/generate-component-api.mjs",
    "generate:search": "node ./scripts/generate-showcase-search-index.mjs",
    "generate:search:local": "yarn prepare:granularity && node ./scripts/generate-showcase-search-index.mjs",
    "prepare:granularity": "yarn workspace @feugene/granularity build",
    "test": "yarn generate:api && yarn generate:search && vitest --config vitest.config.ts",
    "test:run": "yarn generate:api && yarn generate:search && vitest run --config vitest.config.ts",
    "test:e2e": "yarn build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "yarn build && playwright test e2e/a11y.spec.ts",
    "test:overlay": "yarn build && playwright test e2e/overlay.spec.ts",
    "test:interaction": "yarn build && playwright test e2e/interaction.spec.ts",
    "test:geometry": "yarn build && playwright test e2e/geometry.spec.ts",
    "test:visual": "yarn build && playwright test e2e/visual.spec.ts",
    "test:visual:update": "yarn build && playwright test e2e/visual.spec.ts --update-snapshots"
  }
}
