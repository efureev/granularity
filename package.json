{
  "name": "@feugene/granularity-workspace",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "yarn build:test-kit && yarn build:granularity && yarn build:chrono && yarn build:charts && yarn build:dashboard && yarn build:forms-schema && yarn build:showcase",
    "build:test-kit": "yarn workspace @feugene/granularity-test-kit build",
    "build:granularity": "yarn workspace @feugene/granularity build",
    "build:chrono": "yarn workspace @feugene/granularity-chrono build",
    "build:charts": "yarn workspace @feugene/granularity-charts build",
    "build:dashboard": "yarn workspace @feugene/granularity-dashboard build",
    "build:forms-schema": "yarn workspace @feugene/granularity-forms-schema build",
    "build:extra": "yarn workspace @feugene/extra-granularity build",
    "build:playground": "yarn workspace @feugene/granularity-playground build",
    "build:showcase": "yarn workspace @feugene/granularity-showcase build",
    "build:playground-empty": "yarn workspace @feugene/granularity-playground-empty build",
    "build:playground-config": "yarn workspace @feugene/granularity-playground-config build",
    "build:playground-theme": "yarn workspace @feugene/granularity-playground-theme build",
    "dev:playground": "yarn workspace @feugene/granularity-playground dev",
    "build:playground-ssr": "yarn workspace @feugene/granularity-playground-ssr build",
    "dev:playground-theme": "yarn workspace @feugene/granularity-playground-theme dev",
    "dev:playground-ssr": "yarn workspace @feugene/granularity-playground-ssr dev",
    "dev:showcase": "yarn workspace @feugene/granularity-showcase dev",
    "test": "yarn test:test-kit && yarn test:granularity && yarn test:chrono && yarn test:charts && yarn test:dashboard && yarn test:extra && yarn test:forms-schema && yarn test:playground && yarn test:playground-theme && yarn test:playground-ssr",
    "test:test-kit": "yarn workspace @feugene/granularity-test-kit test:run",
    "test:granularity": "yarn build:test-kit && yarn workspace @feugene/granularity test:run",
    "test:chrono": "yarn build:test-kit && yarn workspace @feugene/granularity-chrono test:run",
    "test:charts": "yarn build:test-kit && yarn workspace @feugene/granularity-charts test:run",
    "test:dashboard": "yarn build:test-kit && yarn workspace @feugene/granularity-dashboard test:run",
    "test:forms-schema": "yarn build:test-kit && yarn workspace @feugene/granularity-forms-schema test:run",
    "test:extra": "yarn build:test-kit && yarn workspace @feugene/extra-granularity test:run",
    "docs:map": "node scripts/generate-component-map.mjs",
    "docs:check": "node scripts/generate-component-map.mjs --check",
    "docs:audit": "node scripts/docs-audit.mjs --report",
    "docs:audit:check": "node scripts/docs-audit.mjs --check",
    "lint": "yarn lint:test-kit && yarn lint:granularity && yarn lint:chrono && yarn lint:charts && yarn lint:dashboard && yarn lint:forms-schema && yarn lint:showcase",
    "lint:test-kit": "yarn workspace @feugene/granularity-test-kit lint",
    "lint:granularity": "yarn workspace @feugene/granularity lint",
    "lint:chrono": "yarn workspace @feugene/granularity-chrono lint",
    "lint:charts": "yarn workspace @feugene/granularity-charts lint",
    "lint:dashboard": "yarn workspace @feugene/granularity-dashboard lint",
    "lint:forms-schema": "yarn workspace @feugene/granularity-forms-schema lint",
    "lint:showcase": "yarn workspace @feugene/granularity-showcase lint",
    "typecheck": "yarn typecheck:test-kit && yarn typecheck:granularity && yarn typecheck:chrono && yarn typecheck:charts && yarn typecheck:dashboard && yarn typecheck:forms-schema && yarn typecheck:showcase && yarn typecheck:extra && yarn typecheck:unplugin",
    "typecheck:test-kit": "yarn workspace @feugene/granularity-test-kit typecheck",
    "typecheck:granularity": "yarn build:test-kit && yarn workspace @feugene/granularity typecheck",
    "typecheck:chrono": "yarn build:test-kit && yarn workspace @feugene/granularity-chrono typecheck",
    "typecheck:charts": "yarn build:test-kit && yarn workspace @feugene/granularity-charts typecheck",
    "typecheck:dashboard": "yarn build:test-kit && yarn workspace @feugene/granularity-dashboard typecheck",
    "typecheck:forms-schema": "yarn build:test-kit && yarn workspace @feugene/granularity-forms-schema typecheck",
    "typecheck:showcase": "yarn workspace @feugene/granularity-showcase typecheck",
    "coverage:granularity": "yarn build:test-kit && yarn workspace @feugene/granularity test:coverage",
    "test:playground": "yarn workspace @feugene/granularity-playground test:run",
    "test:playground-theme": "yarn workspace @feugene/granularity-playground-theme test:run",
    "test:playground-ssr": "yarn workspace @feugene/granularity-playground-ssr test:run",
    "test:showcase": "yarn workspace @feugene/granularity-showcase test:run",
    "test:a11y": "yarn workspace @feugene/granularity-showcase test:a11y",
    "test:visual": "yarn workspace @feugene/granularity-showcase test:visual",
    "typecheck:playground-config": "yarn workspace @feugene/granularity-playground-config typecheck",
    "typecheck:extra": "yarn build:test-kit && yarn workspace @feugene/extra-granularity typecheck",
    "typecheck:unplugin": "yarn workspace @feugene/unplugin-granularity typecheck",
    "test:unplugin": "yarn workspace @feugene/unplugin-granularity test:run"
  }
}
